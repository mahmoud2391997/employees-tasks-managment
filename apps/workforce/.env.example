# Local development
WORKFORCE_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/workforce?schema=public"

# Auth
WORKFORCE_JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Single company. Public signup and extra teams are disabled.
# The admin account is created on startup. Add other people from الأعضاء → دعوة.
WORKFORCE_DEMO_MODE="false"
COMPANY_NAME="الشركة"
COMPANY_ADMIN_EMAIL="admin@company.local"
COMPANY_ADMIN_PASSWORD="replace-with-your-admin-password"
# COMPANY_ADMIN_FIRST_NAME="مدير"
# COMPANY_ADMIN_LAST_NAME="الشركة"

# Required in production so invitations and notifications are emailed.
# Local development can omit SMTP; the invite link is still shown in the app.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Workforce <workforce@example.com>"
# SITE_URL="https://workforce.example.com"

