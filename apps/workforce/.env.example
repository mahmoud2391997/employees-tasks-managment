# Local development
WORKFORCE_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workforce?schema=public"

# Auth
WORKFORCE_JWT_SECRET="change-me"

# Single company. Public signup and extra teams are disabled.
# The admin account is created on startup. Add other people from الأعضاء → دعوة.
WORKFORCE_DEMO_MODE="false"
COMPANY_NAME="الشركة"
COMPANY_ADMIN_EMAIL="admin@company.local"
COMPANY_ADMIN_PASSWORD="change-me-please"
# COMPANY_ADMIN_FIRST_NAME="مدير"
# COMPANY_ADMIN_LAST_NAME="الشركة"

# Optional: used by invite emails (not required to run).
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="workforce@example.com"
# SITE_URL="http://localhost:3001"

